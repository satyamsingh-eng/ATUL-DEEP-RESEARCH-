# Default-deny publication policy.
# The committed surface is a private, Markdown-first board package.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Atul_Bansal_C3A_Network_Intelligence_Report.md
!/Atul_Bansal_Master_Executive_Brief.md
!/Atul_Bansal_Master_Executive_Brief.html
!/index.html
!/TiE_Angels_Intelligence_Brief.html
!/SARVAX_Founder_Operator_One_Pager_Draft.md
!/reports/
!/reports/*.md

# Legacy browser reports, renderers, and UI QA are intentionally not releasable.
*.html
*.htm
!/Atul_Bansal_Master_Executive_Brief.html
!/index.html
!/TiE_Angels_Intelligence_Brief.html

# Never publish local/system/transient artifacts even if a future allow rule is added.
.DS_Store
__pycache__/
*.py[cod]
*.log
*.png
*.jpg
*.jpeg
*.webp
.env*
*.env
*.env.*
*.pem
*.key

# Restricted enrichment remains local-only and out of every report/release surface.
private_contact_enrichment/
