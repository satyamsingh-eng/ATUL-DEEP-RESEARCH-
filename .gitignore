# Default-deny publication policy: version only the reviewed release set.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/Atul_Bansal_C3A_Network_Intelligence_Report.md
!/Atul_Bansal_C3A_Network_Intelligence_Report.html
!/render_report.py
!/release/
/release/*
!/release/manifest.json
!/release/pre-push-security-audit.json
!/release/ui-qa-summary.json
!/release/final-release-validation.json
!/release/validate_final_release.py
!/evidence/
/evidence/*
!/evidence/apollo_validation/
/evidence/apollo_validation/*
!/evidence/apollo_validation/run_focused_report_qa.py

!/reports/
!/reports/README.md
!/reports/Atul_Bansal_Professional_Kundali_Final_2026.html
!/reports/Atul_Bansal_Professional_Kundali_Evidence_2026.json
!/reports/final_kundali_validation.json
!/reports/final_kundali_browser_qa.json

# Never publish local/system/transient artifacts even if a future allow rule is added.
.DS_Store
__pycache__/
*.py[cod]
*.log
*.png
*.jpg
*.jpeg
*.webp
.env*
.env
.env.*
*.pem
*.key
